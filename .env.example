# Copy this file to `.env.local` and adjust.

# Address of the backend API, reachable from the machine running Next.js.
# Server-side only — never prefix with NEXT_PUBLIC_.
# Local dev and Vercel both use the live backend over HTTPS. The bare IP
# (http://147.93.4.107) no longer serves the API.
BACKEND_URL=https://db-api.nordencapital.ca

# Shared secret that proves a request to the backend comes from this app. The
# backend refuses every /api call without it (401 PROXY_SECRET_INVALID).
# Server-side only: NEVER prefix with NEXT_PUBLIC_ and never commit the value.
# Same value as the GitHub secret PROXY_SECRET of masterdb-backend and the
# Vercel variable PROXY_SECRET. Paste it from the clipboard; never type or
# print it.
PROXY_SECRET=
